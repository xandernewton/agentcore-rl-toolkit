# Written by cdk/deploy.sh (copy to .env first only to set the optional values below).
AGENTCORE_AGENT_ARN=
AGENTCORE_S3_BUCKET=
SWEGREP_CORPUS_BUCKET=
AWS_REGION=

# Where the benchmark harness and scorers extract repo checkouts (1,172 for the two benchmarks). The
# default, /tmp/swegrep_repos, is RAM on hosts where /tmp is a tmpfs: point it at local disk.
SWEGREP_CACHE_DIR=/var/tmp/swegrep_repos

# Optional
# WANDB_API_KEY=...                 # metrics to W&B project "swegrep"
# HF_TOKEN=...                      # only if Hugging Face rate-limits anonymous downloads
# MODEL_DIR=/path/to/Qwen3.5-9B     # default: the pinned snapshot in the Hugging Face cache
# TINKER_PORT=18080                 # port of the local SkyRL endpoint
