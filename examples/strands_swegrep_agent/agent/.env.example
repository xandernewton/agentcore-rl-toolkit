# Agent-side settings for local testing of rl_app.py (agent/local_test.py needs none of them).
# In AgentCore these come from the runtime environment, set by the CDK stack from cdk/config.yaml and
# the recipe's swegrep.runtime_env, and credentials from the execution role.

AWS_REGION=us-east-1
# Bucket of repo snapshots ({repo}@{base_commit} tarballs under repos/), filled by scripts/prepare_corpus.py.
SWEGREP_CORPUS_BUCKET=my-swegrep-corpus-bucket
# Where snapshots are extracted (default /tmp/swegrep_repos).
# SWEGREP_CACHE_DIR=/tmp/swegrep_repos

# Harness (repo_tools.py, turn_cap.py); the defaults are the published model's.
# SWEGREP_MAX_TURNS=16  SWEGREP_CONTEXT_BUDGET_TOKENS=44000  SWEGREP_TOOL_MAX_CHARS=8000
# SWEGREP_FINAL_USER_TURN=always   # or auto: skip the final user turn when a tool result already nudged

# Reward (reward.py); the ablation recipes vary beta.
# SWEGREP_BETA=2
